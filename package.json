{
  "name": "paps-tracker",
  "version": "1.2.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:ci": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "migrate:demo-store": "node --import tsx scripts/migrate-demo-store-to-sheets.ts"
  },
  "dependencies": {
    "google-auth-library": "^10.6.2",
    "next": "^15.5.24",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "nanoid": "3.3.18",
      "sharp": "0.35.3"
    }
  }
}
